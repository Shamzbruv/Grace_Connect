<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Grace Connect</string>
    <key>CFBundleDisplayName</key>
    <string>Grace Connect</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>GoogleMapsApiKey</key>
    <string>$(GOOGLE_MAPS_API_KEY_IOS)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Grace Connect uses your location to automatically mark you present at church during services.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Grace Connect uses your location to automatically mark you present at church during services.</string>
    <key>NSCameraUsageDescription</key>
    <string>Grace Connect needs access to the camera to allow you to take photos for your profile and the community feed.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Grace Connect needs microphone access to record voice notes and media for secure messages.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Grace Connect needs access to your photo library to allow you to upload photos for your profile and the community feed.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Grace Connect may save media you create or receive when you choose to keep it.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Grace Connect accesses your calendar only when you choose to add or update an event reminder.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Grace Connect needs calendar access to add the events you choose, keep those entries updated, and set your selected reminders.</string>
    <key>NSCalendarsWriteOnlyAccessUsageDescription</key>
    <string>Grace Connect can add an event reminder when you explicitly choose calendar sync.</string>
    <key>NSUserNotificationsUsageDescription</key>
    <string>Grace Connect sends church updates, messages, Bible Nudges, and attendance reminders.</string>
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>youtube</string>
        <string>youtubei</string>
        <string>youtubes</string>
        <string>tel</string>
        <string>mailto</string>
    </array>
    <!-- Deep linking for Supabase Authentication -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>app.graceconnect.church</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
